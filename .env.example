# Copy to `.env.local` and fill in values from Firebase Console
# (Project settings → Your apps). Restart `npm run dev` after changes.

# --- Firebase (Web client) ---
# Prefer creating a NEW project under vivaliang1018@gmail.com, then paste:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional: named Firestore database id (leave empty for "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# --- Privacy Policy (public HTTPS URL for App Store Connect) ---
# After enabling GitHub Pages on this repo, e.g.:
# https://YOUR_GITHUB_USERNAME.github.io/match3-vocab-game/privacy.html
VITE_PRIVACY_POLICY_URL=
