# Copy to `.env.local` and fill in values from Firebase Console
# (Project settings → Your apps). Restart `npm run dev` after changes.

# --- Firebase (Web client) ---
# Prefer creating a NEW project under vivaliang1018@gmail.com, then paste:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional: named Firestore database id (leave empty for "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# App Store Connect non-consumable Product ID (not secret).
# Leave blank until the non-consumable product exists; purchase UI remains disabled.
VITE_PLUS_LIFETIME_PRODUCT_ID=

# AdMob rewarded ad unit (not secret). Development builds always use Google's
# official test unit; production builds use this value.
VITE_ADMOB_REWARDED_AD_UNIT_ID=

# Enable only after deploying the repository's updated firestore.rules.
VITE_CLOUD_DAILY_QUOTA=0

# --- Privacy Policy / Terms (public HTTPS URLs for App Store Connect) ---
# GitHub Pages (this repo uses /docs):
# https://vivaliang1018-ux.github.io/match3-vocab-game/privacy.html
# https://vivaliang1018-ux.github.io/match3-vocab-game/terms.html
# https://vivaliang1018-ux.github.io/match3-vocab-game/support.html
VITE_PRIVACY_POLICY_URL=https://vivaliang1018-ux.github.io/match3-vocab-game/privacy.html
VITE_TERMS_OF_SERVICE_URL=https://vivaliang1018-ux.github.io/match3-vocab-game/terms.html
