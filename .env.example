# Copy to `.env.local` and fill in values from Firebase Console
# (Project settings → Your apps). Restart `npm run dev` after changes.

# --- Firebase (Web client) ---
# Prefer creating a NEW project under vivaliang1018@gmail.com, then paste:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Optional: named Firestore database id (leave empty for "(default)")
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# --- Privacy Policy / Terms (public HTTPS URLs for App Store Connect) ---
# GitHub Pages (this repo uses /docs):
# https://vivaliang1018-ux.github.io/match3-vocab-game/privacy.html
# https://vivaliang1018-ux.github.io/match3-vocab-game/terms.html
VITE_PRIVACY_POLICY_URL=https://vivaliang1018-ux.github.io/match3-vocab-game/privacy.html
VITE_TERMS_OF_SERVICE_URL=https://vivaliang1018-ux.github.io/match3-vocab-game/terms.html
