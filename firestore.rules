// ===============================================================
// Match-3 Vocab Game — Firestore rules
//
// Path: /users/{userId}/match3/state--{courseId}
// Each language course has an isolated learning/progress document. `state` is
// retained temporarily so existing English-course progress can migrate.
//
// Deploy:
//   firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidMatch3State() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'memories', 'learnedIds', 'modeUnlocks', 'playerSummary',
          'categoryCycles', 'updatedAtMs', 'updatedAt'
        ])
        && d.keys().hasAll(['updatedAtMs', 'updatedAt'])
        && d.get('memories', []) is list
        && d.get('memories', []).size() <= 5000
        && d.get('learnedIds', []) is list
        && d.get('learnedIds', []).size() <= 5000
        && d.get('modeUnlocks', {}) is map
        && d.get('playerSummary', {}) is map
        && d.get('categoryCycles', {}) is map
        && d.updatedAtMs is number
        && d.updatedAt is timestamp;
    }

    match /users/{userId}/match3/{docId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && (docId == 'state' || docId.matches('^state--[A-Za-z-]+$'))
        && isValidMatch3State();
      allow delete: if isOwner(userId)
        && (docId == 'state' || docId.matches('^state--[A-Za-z-]+$'));
    }

    function validDailyQuota(dayKey) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'dayKey', 'staminaValue', 'spentToday', 'sayBlastRewardsToday', 'adResetsToday', 'moodPlaysToday', 'updatedAt'
        ])
        && d.keys().hasAll([
          'dayKey', 'staminaValue', 'spentToday', 'sayBlastRewardsToday', 'adResetsToday', 'moodPlaysToday', 'updatedAt'
        ])
        && d.dayKey == dayKey
        && d.staminaValue is int && d.staminaValue >= 0 && d.staminaValue <= 3
        && d.spentToday is int && d.spentToday >= 0 && d.spentToday <= 10000
        && d.sayBlastRewardsToday is int && d.sayBlastRewardsToday >= 0
        && d.sayBlastRewardsToday <= 10000
        && d.adResetsToday is int && d.adResetsToday >= 0
        && d.adResetsToday <= 2
        && d.moodPlaysToday is int && d.moodPlaysToday >= 0
        && d.moodPlaysToday <= 3
        && d.updatedAt == request.time;
    }

    match /users/{userId}/dailyQuotas/{dayKey} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validDailyQuota(dayKey);
      allow update: if isOwner(userId) && validDailyQuota(dayKey)
        && request.resource.data.spentToday >= resource.data.spentToday
        && request.resource.data.sayBlastRewardsToday >= resource.data.sayBlastRewardsToday
        && (!resource.data.keys().hasAny(['adResetsToday'])
          || request.resource.data.adResetsToday >= resource.data.adResetsToday)
        && request.resource.data.moodPlaysToday >= resource.data.moodPlaysToday;
      // Required by account deletion. A determined modified client can also
      // delete its own ledger; strict anti-abuse requires server-issued quotas.
      allow delete: if isOwner(userId);
    }

    // Shared project paths (smelly-cat-dictation) — owner-only.
    match /users/{userId}/progress/{episodeId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/wordCards/{cardId} {
      allow read, write: if isOwner(userId);
    }
    match /users/{userId}/savedNotes/{saveId} {
      allow read, write: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
